# ─────────────────────────────────────────────────────────────────────────────
# Cyber Swarm environment — copy to  swarm/.env  on the Frankfurt VPS and fill in.
# NEVER commit the real .env. Rotate any key that has ever been pasted in plaintext.
# ─────────────────────────────────────────────────────────────────────────────

# KiloCode (OpenAI-compatible router). Your JWT. ROTATE the one pasted in chat.
KILOCODE_API_KEY=
KILOCODE_BASE_URL=https://kilo.ai/api/openrouter/v1

# Per-role models are chosen automatically (5 different free models). Override if you like:
# SWARM_MODEL_RECON=reflection/beam-free
# SWARM_MODEL_ATTACKER=nvidia/nemotron-3-ultra-550b-a55b:free
# SWARM_MODEL_SKEPTIC=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# SWARM_MODEL_EXPLOIT_DEV=cohere/north-mini-code:free
# SWARM_MODEL_REFEREE=kilo-auto/free

# Chains — archive RPCs (needed for analysis + fork-proving). ROTATE the QuickNode token.
ETH_ARCHIVE_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BSC_ARCHIVE_RPC=https://YOUR-ENDPOINT.bsc.quiknode.pro/YOUR_QUICKNODE_TOKEN/
ETHERSCAN_API_KEY=

# Safety rails (defaults are sane)
SWARM_MIN_CALL_INTERVAL=2.0
SWARM_MAX_CALLS_PER_TARGET=60
SWARM_MAX_SECONDS_PER_TARGET=1200
SWARM_MAX_CALLS_PER_DAY=5000
SWARM_MAX_TOKENS=3000

# Target acquisition
SWARM_CHAINS=ethereum,bsc
SWARM_MAX_TVL=500000
SWARM_MIN_TVL=1000
SWARM_MAX_AGE_DAYS=30
SWARM_USE_IMMUNEFI=true
SWARM_USE_DEFILLAMA=true

# Server
SWARM_HOST=0.0.0.0
SWARM_PORT=8080
